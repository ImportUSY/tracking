# ============================================================================
# Tracking Logístico - variables de entorno
# Copie este archivo como .env y complete los valores marcados como OBLIGATORIO.
# ============================================================================

# --- General ---------------------------------------------------------------
APP_ENV=production                 # development | production
LOG_LEVEL=INFO
LOG_JSON=true                      # logs en JSON (una línea por evento)
TIMEZONE=America/Caracas
# Jornada laboral para los tiempos entre procesos (lunes a viernes; un día hábil = FIN - INICIO horas)
JORNADA_INICIO=7
JORNADA_FIN=16
# Clave temporal de usuarios y conductores nuevos (vacía = aleatoria) y cuántos ingresos permite antes de
# exigir la clave personal
CLAVE_TEMPORAL=qwerty
ACCESOS_CLAVE_TEMPORAL=3
# Orígenes permitidos para CORS (solo si la app se sirve desde otro dominio). Separados por coma.
CORS_ORIGINS=

# --- Seguridad -------------------------------------------------------------
# OBLIGATORIO en producción. Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Primer supervisor: se crea automáticamente si la base no tiene usuarios.
BOOTSTRAP_ADMIN_USER=supervisor
BOOTSTRAP_ADMIN_PASSWORD=
STAFF_TOKEN_MINUTES=720            # sesión del personal de oficina (12 h)
DRIVER_TOKEN_DAYS=14               # sesión del conductor (debe aguantar días sin señal)
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
# Ingreso con la huella o el rostro del teléfono (WebAuthn). Solo funciona por https (o localhost).
# Vacíos = se usa el dominio con que se abre la app. Si cambia de dominio, las huellas activadas dejan de servir.
BIOMETRIA_HABILITADA=true
WEBAUTHN_RP_ID=                    # p. ej. tracking.fermetal.com (sin https:// ni puerto)
WEBAUTHN_ORIGENES=                 # p. ej. https://tracking.fermetal.com

# --- Control de acceso (RBAC) ---------------------------------------------
# Roles que pueden crear usuarios CONDUCTOR (separados por coma).
#   supervisor,transportista  -> ambos (por defecto)
#   transportista             -> solo el transportista
CONDUCTOR_CREATOR_ROLES=supervisor,transportista

# --- Base de datos ---------------------------------------------------------
# Desarrollo local: SQLite. Producción: PostgreSQL.
DATABASE_URL=sqlite:///./data/tracking.db
# DATABASE_URL=postgresql://tracking:CLAVE@localhost:5432/tracking
DB_AUTO_MIGRATE=true
# Solo para docker-compose:
POSTGRES_PASSWORD=
BACKUP_RETENTION_DAYS=14
DOMAIN=localhost                   # dominio público para HTTPS automático (Caddy)
WEB_CONCURRENCY=2

# --- Archivos --------------------------------------------------------------
# disk = carpeta STORAGE_DIR | db = dentro de PostgreSQL (automático en Vercel, que no tiene disco)
STORAGE_BACKEND=disk
STORAGE_DIR=./data/fotos
MAX_EXCEL_MB=30
MAX_PHOTO_MB=10

# --- APK Android (ver APK_ANDROID.md) ---------------------------------------
# Pegue el contenido de assetlinks.json de PWABuilder (o use las dos variables siguientes)
ANDROID_ASSETLINKS_JSON=
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
# Detrás de un proxy (Vercel, Caddy, nginx) tomar la IP real de X-Forwarded-For
TRUST_PROXY_HEADERS=true

# --- Consulta pública ------------------------------------------------------
PUBLIC_RATE_LIMIT_PER_MINUTE=30
# Evidencia fotográfica (Proof of Delivery) en la consulta pública: enlace firmado y temporal a la foto
# de Entregada / Devolución. false = la consulta pública nunca muestra fotos.
PUBLIC_EVIDENCE_ENABLED=true
EVIDENCE_URL_TTL_MINUTES=30

# --- Pie de la pantalla de inicio ----------------------------------------------
# «Versión X.X.X · Octubre 2026». La versión sale de pyproject/tracking.__version__; VERSION_PUBLICA
# permite mostrar otra sin tocar el código.
# VERSION_PUBLICA=
FECHA_CREACION=Octubre 2026

# --- Captura de facturas por foto (OCR) --------------------------------------
# Sin configurar nada: OCR GRATUITO en el teléfono/PC (PaddleOCR en el navegador). Opcional y de pago:
# si pone ANTHROPIC_API_KEY, la lectura la hace un modelo de visión de Anthropic.
OCR_ENABLED=true
# OCR_MODEL=          # vacío = ANTHROPIC_MODEL

# --- IA (opcional) ---------------------------------------------------------
# Revisión asistida del resumen de carga y asociación de columnas renombradas.
AI_REVIEW_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_TIMEOUT_SECONDS=60

# --- Correo (segunda entrega) ----------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM=transporte@example.com
COBRANZAS_EMAILS=cobranzas@example.com
