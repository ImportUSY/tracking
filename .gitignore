tracking-logistico/data/
tracking-logistico/backups/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vercel/
*.egg-info/

# --- Sistema ---
Thumbs.db
desktop.ini
~$*
