# Llave de firma del APK: con ella se publican actualizaciones en Google Play
**/LLAVE_DE_FIRMA_no_compartir/
*.keystore
*.jks
signing-key-info.txt
# Paquete de PWABuilder: trae la llave de firma adentro
APK/*.zip
# Claves de la base de producción (Neon), SECRET_KEY, etc. La plantilla .env.example sí se sube.
.env
.env.*
!.env.example

